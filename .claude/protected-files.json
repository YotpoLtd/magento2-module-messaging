{
  "version": 1,
  "matching": "If a path matches more than one tier's globs, the most restrictive tier applies: human-required > review-required > auto-safe.",
  "tiers": {
    "human-required": {
      "description": "Agent CANNOT modify without a human. Prod-impacting or irreversible. Document for CODEOWNERS and agent instructions.",
      "paths": [
        "etc/db_schema.xml",
        "etc/db_schema_whitelist.json",
        "Setup/**",
        "composer.json",
        "etc/module.xml",
        "registration.php",
        "Api/**",
        "etc/csp_whitelist.xml",
        "Controller/AbandonedCart/**",
        "Model/AbandonedCart/**",
        "Plugin/Customer/Account/LoginPost.php",
        "LICENSE.txt",
        "LICENSE_AFL.txt",
        ".github/workflows/**",
        ".agents/adlc/**",
        "CODEOWNERS",
        ".claude/protected-files.json"
      ]
    },
    "review-required": {
      "description": "Agent can modify but the PR requires human approval, including agent instructions/skills.",
      "paths": [
        "etc/**",
        "Model/**",
        "Plugin/**",
        "Observer/**",
        "Controller/**",
        "Block/**",
        "CustomerData/**",
        "Helper/**",
        "ViewModel/**",
        "view/**",
        "README.md",
        ".gitignore",
        "CLAUDE.md",
        "AGENTS.md",
        ".claude/**",
        ".github/pull_request_template.md"
      ]
    },
    "auto-safe": {
      "description": "Agent can freely modify. Auto-merge eligible.",
      "paths": [
        "docs/**",
        "**/*.md"
      ]
    }
  }
}
